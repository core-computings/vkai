#version 450
layout(binding = 0) uniform Parameters { int element_count; float alpha; float beta; int reserved; } ubo;
layout(binding = 1, std430) readonly buffer Input { float x[]; };
layout(binding = 2, std430) writeonly buffer Output { float y[]; };
layout(local_size_x = 256) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < uint(ubo.element_count)) y[i] = clamp(ubo.alpha * x[i] + ubo.beta, 0.0, 1.0);
}
