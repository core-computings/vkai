#version 450

layout(binding = 0) uniform UniformBufferObject {
    int input_size;
    int output_size;
    int batch_size;
}
ubo;

layout(set = 0, binding = 1, std430) readonly buffer InputBuffer {
    float input_buffer[];
};

layout(set = 0, binding = 2, std430) readonly buffer WeightBuffer {
    float weight_buffer[];
};

layout(set = 0, binding = 3, std430) readonly buffer BiasBuffer {
    float bias_buffer[];
};

layout(set = 0, binding = 4, std430) writeonly buffer OutputBuffer {
    float output_buffer[];
};

// Each workgroup computes a 16x16 [batch, output] tile. K is loaded in
// matching tiles so its values are reused from workgroup-local memory.
const uint kTileSize = 16;
layout(local_size_x = kTileSize, local_size_y = kTileSize, local_size_z = 1) in;

shared float input_tile[kTileSize][kTileSize];
shared float weight_tile[kTileSize][kTileSize];

// input: [batch_size, input_size]
// weights: [output_size, input_size]
// bias: [output_size]
// output: [batch_size, output_size]

void main()
{
    const uint local_out = gl_LocalInvocationID.x;
    const uint local_batch = gl_LocalInvocationID.y;
    const uint out_idx = gl_WorkGroupID.x * kTileSize + local_out;
    const uint batch_idx = gl_WorkGroupID.y * kTileSize + local_batch;
    const uint input_size = uint(ubo.input_size);
    const uint output_size = uint(ubo.output_size);
    const uint batch_size = uint(ubo.batch_size);

    float sum = 0.0;

    for (uint tile_start = 0; tile_start < input_size; tile_start += kTileSize) {
        const uint input_idx = tile_start + local_out;
        const uint weight_idx = tile_start + local_batch;

        input_tile[local_batch][local_out] =
            (batch_idx < batch_size && input_idx < input_size)
                ? input_buffer[batch_idx * input_size + input_idx]
                : 0.0;
        weight_tile[local_batch][local_out] =
            (out_idx < output_size && weight_idx < input_size)
                ? weight_buffer[out_idx * input_size + weight_idx]
                : 0.0;
        barrier();

        for (uint k = 0; k < kTileSize; ++k) {
            sum += input_tile[local_batch][k] * weight_tile[k][local_out];
        }
        barrier();
    }

    if (batch_idx < batch_size && out_idx < output_size) {
        output_buffer[batch_idx * output_size + out_idx] = sum + bias_buffer[out_idx];
    }
}
