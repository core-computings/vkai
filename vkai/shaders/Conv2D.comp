#version 450

layout(binding = 0) uniform UniformBufferObject {
    int input_width;
    int input_height;
    int input_channels;
    int batch_size;

    int output_width;
    int output_height;
    int output_channels;
    int padding_type;

    int kernel_width;
    int kernel_height;
    int stride_width;
    int stride_height;

    int padding_width;
    int padding_height;
    int dilation_width;
    int dilation_height;
    int groups;
    int fuse_relu;
    int reserved_1;
    int reserved_2;
}
ubo;

layout(set = 0, binding = 1, std430) readonly buffer InputBuffer {
    float input_buffer[];
};

layout(set = 0, binding = 2, std430) readonly buffer WeightBuffer {
    float weight_buffer[];
};

layout(set = 0, binding = 3, std430) writeonly buffer OutputBuffer {
    float output_buffer[];
};

layout(set = 0, binding = 4, std430) readonly buffer BiasBuffer {
    float bias_buffer[];
};

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// input:   [batch_size, input_channels, input_height, input_width] (NCHW)
// weights: [output_channels, input_channels, kernel_height, kernel_width] (OIHW)
// output:  [batch_size, output_channels, output_height, output_width] (NCHW)

int reflect_index(int index, int size) {
    if (size <= 1) {
        return 0;
    }

    // A closed-form mirrored period avoids divergent loops, which also
    // miscompile on some mobile GPU drivers when called inside convolution.
    int period = 2 * (size - 1);
    int position = abs(index) % period;
    return min(position, period - position);
}

void main() {
    uint global_idx = gl_GlobalInvocationID.x;
    uint output_element_count = uint(
        ubo.batch_size * ubo.output_channels * ubo.output_height * ubo.output_width);
    if (global_idx >= output_element_count) {
        return;
    }

    uint remaining = global_idx;
    int output_x = int(remaining % uint(ubo.output_width));
    remaining /= uint(ubo.output_width);
    int output_y = int(remaining % uint(ubo.output_height));
    remaining /= uint(ubo.output_height);
    int output_channel = int(remaining % uint(ubo.output_channels));
    int batch = int(remaining / uint(ubo.output_channels));

    float sum = bias_buffer[output_channel];
    int channels_per_group = ubo.input_channels / ubo.groups;
    int first_channel = (output_channel / (ubo.output_channels / ubo.groups)) * channels_per_group;
    for (int local_channel = 0; local_channel < channels_per_group; ++local_channel) {
        int input_channel = first_channel + local_channel;
        for (int kernel_y = 0; kernel_y < ubo.kernel_height; ++kernel_y) {
            int input_y = output_y * ubo.stride_height + kernel_y * ubo.dilation_height - ubo.padding_height;

            for (int kernel_x = 0; kernel_x < ubo.kernel_width; ++kernel_x) {
                int input_x = output_x * ubo.stride_width + kernel_x * ubo.dilation_width - ubo.padding_width;
                int sample_x = input_x;
                int sample_y = input_y;

                bool outside = input_x < 0 || input_x >= ubo.input_width ||
                               input_y < 0 || input_y >= ubo.input_height;
                if (outside) {
                    if (ubo.padding_type == 0) {
                        continue;
                    }
                    sample_x = reflect_index(input_x, ubo.input_width);
                    sample_y = reflect_index(input_y, ubo.input_height);
                }

                uint input_idx = uint(
                    ((batch * ubo.input_channels + input_channel) * ubo.input_height + sample_y) *
                        ubo.input_width +
                    sample_x);
                uint weight_idx = uint(
                    ((output_channel * channels_per_group + local_channel) * ubo.kernel_height +
                     kernel_y) *
                        ubo.kernel_width +
                    kernel_x);
                sum += input_buffer[input_idx] * weight_buffer[weight_idx];
            }
        }
    }

    output_buffer[global_idx] = ubo.fuse_relu != 0 ? max(sum, 0.0) : sum;
}
