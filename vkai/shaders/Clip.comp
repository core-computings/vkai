#version 450
layout(binding = 0) uniform Parameters { int element_count; float lower; float upper; int reserved; } ubo;
layout(binding = 1, std430) readonly buffer Input { float x[]; };
layout(binding = 2, std430) writeonly buffer Output { float y[]; };
layout(local_size_x = 256) in;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < uint(ubo.element_count)) y[i] = clamp(x[i], ubo.lower, ubo.upper);
}
